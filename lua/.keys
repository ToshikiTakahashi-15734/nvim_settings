# ---------------------------------------------------------
# 1. 一覧表示コマンド (keys)
# ---------------------------------------------------------
alias keys='echo "
📌 【マイ・ショートカット備忘録】

■ 行の上下移動 (Option + ↑/↓)
  1行だけ : その行で option + ↑ または option + ↓
  複数行  : V でビジュアル行選択 → j/k で範囲を広げる → option + ↑ または option + ↓

■ ターミナル操作
  option + n           : 次のタブへ移動
  option + shift + →   : 垂直分割（左右分割）
  option + shift + ↓   : 水平分割（上下分割）
  option + cmd + 矢印  : ペイン間を移動（←→↑↓）
  option + x           : 現在のペインを閉じる
  control + l : 画面をキレイにする
  shift + commnd + i : 背景を透過
 
■ タブ操作 (Tab / File)
  te [file]  : 新規タブで開く (Tab Edit)
  gn         : 次のタブへ (Go Next)
  gp         : 前のタブへ (Go Previous)
  tx         : タブを閉じる (Tab X)
  Cmd + t    : 新規タブを開く

■ 全体操作 / 編集
　:e　　　　 : テキストファイルを作成（テキストファイルがない場合）
　:!mkdir    : 親ディレクトリの作成
　:w　　　　 : ファイルを保存
  gg         : 文頭へ移動
  G          : 文末へ移動
  V + G      : 文頭から文末まで全選択
  :%y        : 全コピー (All Yank)
  :%d        : 全削除 (All Delete)
  gd         : 定義ジャンプ（小窓）  gr : 参照一覧（右パネル・ファイル別ツリー・VSCode風）
  K          : 現在行のリンター/LSPエラーを枠で表示（ホバーでも表示）
  :lua vim.lsp.buf.format() : コード整形
  control + u + o : 以前のファイルに戻る
  control + r : やり直し (Redo)

■ 行ジャンプ
  :123 : 123行目にジャンプ
  123G : 123行目にジャンプ
  10j  : 今いる箇所から10行下に行く
  10k  : 今いる箇所から10行上に行く

■ ファイル操作
　:!rm % : ファイルを削除

■ コピー＆ペースト
  yy         : 1行コピー
  p          : 貼り付け
  v -> y     : 範囲選択してコピー

■ 選択範囲を囲む
  【Insert から】 qw → ( か { か [ で囲む
    Insert で q → w  : 現在の単語を選択（ビジュアルになる）
    続けて ( か { か [ : 選択を () / {} / [] で囲む
  【従来】 v / viw で選択 → Space w " など
  Space w "  : "" で囲む   Space w b  : {} で囲む
  Space w '  : '' で囲む   Space w p  : () で囲む
  Space w s  : [] で囲む   Space w `  : `` で囲む

■ ファイルを開く時 (検索画面など)
  Enter      : 現在の窓で開く
  Ctrl + v   : 左右に分割して開く (Vertical)
  Ctrl + x   : 上下に分割して開く
  Ctrl + t   : 新規タブで開く

■ 基本・移動
  画面下のステータスライン左に現在モードを表示（NORMAL / INSERT 等・色で区別）
  jk          : 挿入モードを抜ける
  <leader>nh  : 検索ハイライトを消す
  gd          : 定義先にジャンプ（小窓）  gr : 参照一覧（右パネル・ファイル別）
  K           : 現在行のエラーを枠で表示（VSCodeのホバー風）
  <leader>ce  : ファイルパス:行番号（＋その行のエラー）をコピー

■ 画面分割
  <leader>sv  : 画面を左右に分割（縦線で区切る）
  <leader>sh  : 画面を上下に分割（横線で区切る）
  Ctrl + w + h/j/k/l : 画面間を移動
  option + commnd + テンキー：画面間を移動
  :p          : 画面分割したタブを削除

■ 検索 (Telescope)
  <leader>f   : ファイル名検索
  <leader><leader> : 全文検索（プロジェクト全体）。検索中 Ctrl+h で「履歴ファイルのみ」に絞る
  <leader>p   : プロジェクト切替
  <leader>?   : 自作ショートカット一覧
  <leader>nh  : 検索ハイライトを消す
  /（前方）・?（後方） : 文字列検索
  Enter 2回   : 検索プロンプトを出す（/ と同じ）
  Esc         : 検索ハイライトを消す
  Cmd + f     : ファイル内をあいまい検索
  <leader>sf  : 拡張子を指定してファイル検索
  <leader>sz  : 拡張子を指定して全文検索

■ コマンド集 (Cheatsheet)
  <leader>H   : コマンド集を開く（備忘録・キーマップ・コマンドの3タブ）
  :Cheatsheet : コマンド集を開く
  :Cheatsheet search  : いきなり横断検索（Telescope）を開く
  :Cheatsheet memo / keymaps / cmds : 指定したタブで開く
# コマンド集の画面内
  Tab / Shift+Tab : タブ切替（1 / 2 / 3 で直接切替）
  /           : 全タブ横断で絞り込み検索
  Enter       : キーマップは実行、コマンドはコマンドラインに入力
  e           : 備忘録（このファイル）を編集
  q / Esc     : 閉じる

■ 編集の便利キー
  aa          : コメントのトグル（ビジュアル選択中なら選択範囲）
  Ctrl + a / Cmd + a : 全選択
  Cmd + z     : 元に戻す（インサート中も可）
  Cmd + u     : やり直し（インサート中も可）
  Ctrl + Space : 構文のまとまり単位で選択を広げる（押すたびに拡大）
  BS          : （ビジュアル中）広げた選択を1段階戻す
  Option + ← / → : ジャンプ履歴を戻る / 進む
  Option + Shift + f : コード整形
  <leader>ya  : 全コピー
  <leader>e   : ファイルツリーを開閉
  T           : フローティングターミナルを開閉
  全角の入力  : コメント・文字列の外では自動で半角に変換（フォーカス時は英数に切替）

■ LSP（定義・参照・エラー）
  gd / Cmd + d : 定義へジャンプ（小窓）
  gr          : 参照一覧（peekウィンドウ）
  K           : 型情報・ドキュメントを表示
  <leader>k   : カーソル位置のエラー・警告をフロート表示
  ]d / [d     : 次 / 前のエラーへ
  <leader>ce  : ファイルパス:行番号（＋その行のエラー）をコピー

■ Git（差分・変更箇所）
  <leader>df  : 差分ビューを開く
  <leader>dfh : このファイルの変更履歴
  <leader>dfH : リポジトリ全体の変更履歴
  <leader>dfc : 差分ビューを閉じる
  <leader>dfr : 差分ビューをリフレッシュ
  ]c / [c     : 次 / 前の変更箇所へ
  <leader>hp  : 変更をプレビュー
  <leader>hs  : 変更をステージ（ビジュアルなら選択範囲）
  <leader>hr  : 変更をリセット（ビジュアルなら選択範囲）
  <leader>hu  : ステージを取り消し
  <leader>hS  : ファイル全体をステージ
  <leader>hR  : ファイル全体をリセット
  <leader>hd  : 差分を表示（index と比較）
  <leader>hD  : 差分を表示（前回commit と比較）
  <leader>hb  : 行のblame詳細
  <leader>hB  : blame表示の切替
  <leader>hl  : 削除行の表示切替

■ GitHub PR
  :GR / <leader>Gp : 自分のPR・レビュー待ちPRの常駐パネルを開閉（30秒ごとに自動更新）
  <leader>Gr / :GhReviewPRs : 同じ一覧をTelescopeで絞り込み検索
# パネルの中
  Enter       : ブラウザで開く
  R           : 差分とAIレビューの画面を開く
  r           : 手動更新
  q           : 閉じる
# レビュー画面の差分の中（diffview）
  c           : この行にコメント（GitHubに投稿。変更箇所の近くの行のみ）
  C           : PR全体にコメント（GitHubに投稿）
  Tab / S-Tab : 次 / 前のファイルへ（diffview標準）
  q           : レビュー画面を閉じる
# レビュー画面の手引きの中
  Enter       : そのファイルの差分へ移動
  x           : 観点のチェックを切替
  q           : レビュー画面を閉じる
# コメント入力の中
  Ctrl-s      : GitHubに投稿
  q / Esc     : 取り消し

■ GitHub タスク (Projects)
  :task       : タスク一覧パネルを開く（設定は task.setting.json）
# タスクパネルの中
  Enter       : Webで開く
  o           : 子タスクをツリーで開閉（子の行で押すと孫も開く）
  u           : URLをコピー
  f           : 一覧を絞り込み（空で解除）
  t           : Telescopeであいまい検索（Enterでその行へカーソル移動）
  w           : Ghosttyの新しいウィンドウでclaudeを起動（リンクと作業指示を渡す）
  s           : GitHubに条件を投げて検索（例 label:bug。空で解除）
  r           : 再取得
  p           : プロジェクト切替
  q           : 閉じる

■ React コンポーネントツリー
  <leader>rt  : 現在ファイルのコンポーネントツリーを表示
  <leader>rp  : ルートコンポーネントを選んでツリー表示
  <leader>rd  : ツリーのデバッグ（treesitterがJSXを認識しているか確認）
# ツリーの中
  Enter       : そのコンポーネントのファイルを開く
  o           : そのコンポーネントを起点にツリーを開き直す
  q / Esc     : 閉じる

■ DB操作 (vim-dadbod)
  接続情報は ~/.config/nvim/db.setting に「接続名 = URL」で書く（Git管理外）
  <leader>db  : サイドバーにDBのテーブル一覧を表示（開閉）
  <leader>dt  : テーブルを絞り込み検索して中身を見る
  <leader>dq  : このプロジェクト専用のSQL練習ファイルを開く（.sql/scratch.sql）
  <leader>dc  : このバッファが使う接続を選び直す（= :DBSelect）
  <leader>de  : テーブルを選んでER図を描く（= :ER）
  :Table      : テーブル一覧を表示（キャッシュも取り直す）
  :Table 名前 : テーブルの中身を表示（Tab で名前を補完）
  :Table 名前 5 : 先頭5行だけ表示
  :Table 名前 id = 3 : 条件を付けて絞り込む
  :Table! 名前 : 列の定義（型・NULL可否・既定値）を見る
  :ER 名前    : ER図を描く（:ER 名前 ホップ数 で範囲指定、! で外部キーを取り直す）
  :DBSelect   : このバッファが使うDB接続を選び直す
  :DB クエリ  : その場でクエリを実行
# SQLファイルの中
  <leader>S   : カーソル位置のクエリを実行（ビジュアル選択中なら選択範囲を実行）
  スニペット  : select / join / groupby などを打って補完から選ぶ（一覧はコマンド集のスニペットタブ）
# <leader>dt の検索画面の中
  Enter       : テーブルの中身を表示
  Ctrl + d    : 列定義を見る
  Ctrl + t    : 件数を数える
  Ctrl + e    : ER図を描く
  Ctrl + y    : テーブル名をカーソル位置に挿入
# <leader>de の検索画面の中
  Enter       : 1ホップ分のER図
  Ctrl + d    : 2ホップ分のER図

■ Claude Code (claudecode.nvim)
  Ctrl+\      : コード ⇔ Claude にフォーカス切替（エディタ側）
  Alt+Space   : Claude ターミナル内で押すと左のエディタにフォーカスを戻す（Ctrl+\ が効かないとき用）
  <leader>ac  : Claude Code を開く/閉じる
  <leader>af  : Claude Code にフォーカス（Ctrl+\ と同じ）
  <leader>ab  : 現在のバッファをコンテキストに追加
  <leader>as  : 選択範囲を Claude に送る (ビジュアルで選択してから)
  <leader>at  : ファイルツリーで選択したファイルを追加 (NvimTree 等)
  <leader>aa  : Claude の diff を採用  <leader>ad  : diff を却下

■ 開発ツール
  <leader>g   : Lazygit起動
  pj [名前]   : プロジェクト移動＆起動

■ Lazygit 基本操作
　?     : キーバインドのヘルプ表示（迷ったらこれ）
　q     : Lazygitを終了
#  ファイル操作 (Filesパネル)
　Space : ステージング（git add / reset)
　a     : 全てのファイルをステージング　
　d     : 変更を破棄（Discard changes）
　Enter : ファイル内に入って行単位でステージング（Range select）
#　コミット・プッシュ (Commits / Filesパネル)
　c     : コミットメッセージを入力してコミット
　A (Shift+a) : 直前のコミットに修正を取り込む（Amend）
　P (Shift+p) : プッシュ (git push)
　p     : プル (git pull)
#　ブランチ・リベース (Branchesパネル)
  Space : チェックアウト
  n     : 新規ブランチ作成
  M (Shift+m) : 選択中のブランチを現在のブランチにマージ
  i     : インタラクティブ・リベース開始
#  履歴操作 (Commitsパネル)
　s     : コミットを一つにまとめる (Squash)
　r     : コミットメッセージの書き換え (Reword)
　g     : コミットのリセット（Soft / Hard 等を選択可能）

■ その他
  :Sengoku    : 戦国風雲録（Vimで天下統一する戦国SLG）を起動
  :SengokuLoad : 戦国風雲録のセーブデータを読み込む

■ プラグイン管理 (Lazy.nvim)
  :Lazy        : プラグインの状態を確認 (現在の画面)
  I            : (:Lazy画面で) インストール実行
  U            : (:Lazy画面で) アップデート実行
  X            : (:Lazy画面で) 不要なプラグインを削除(Clean)

--------------------------------------
💡 「find-key 検索ワード」で絞り込み検索ができます
"'

# ---------------------------------------------------------
# 2. 検索コマンド (find-key)
# ---------------------------------------------------------
find_key() {
    # keys の中身から grep で検索（色付き）
    keys | grep -i --color=auto "$1"
}

# ショートカットキーを検索
alias fk='find_key'

# エイリアス集を編集（保存後に自動反映）
edkey() {
  nvim ~/.config/nvim/lua/.keys
  source ~/.config/nvim/lua/.keys
  echo "✅ Shortcuts updated!"
}

# 手動で再読み込み
alias rekey='source ~/.config/nvim/lua/.keys && echo "✅ Shortcuts updated!"'


